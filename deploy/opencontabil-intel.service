# Coleta diária do módulo Publicações — copie para /etc/systemd/system/
# Disparado pelo opencontabil-intel.timer a cada 5 minutos: o comando só coleta
# quando está na hora configurada (recupera coleta perdida e repete falhas até 3 vezes no dia).

[Unit]
Description=opencontabil — coleta diária do módulo Publicações
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=opencontabil
Group=opencontabil
WorkingDirectory=/opt/opencontabil/backend
EnvironmentFile=/opt/opencontabil/.env
ExecStart=/opt/opencontabil/backend/.venv/bin/flask intel scheduled
# a coleta da Câmara pode levar alguns minutos
TimeoutStartSec=15min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/opencontabil
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
