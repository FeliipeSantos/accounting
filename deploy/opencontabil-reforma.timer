# Verifica a cada 5 minutos se a sincronização diária do Calendário está na hora — copie para /etc/systemd/system/

[Unit]
Description=opencontabil — verificação da sincronização do Calendário

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Unit=opencontabil-reforma.service

[Install]
WantedBy=timers.target
