# Sincronização diária do Calendário — copie para /etc/systemd/system/
# Disparado pelo project-accounting-reforma.timer a cada 5 minutos: o comando só sincroniza
# quando está na hora configurada (recupera sincronização perdida e repete falhas até 3 vezes no dia).

[Unit]
Description=Project Accounting — sincronização diária do Calendário
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=project-accounting
Group=project-accounting
WorkingDirectory=/opt/project-accounting/backend
EnvironmentFile=/opt/project-accounting/.env
ExecStart=/opt/project-accounting/backend/.venv/bin/flask reforma scheduled
# a primeira sincronização baixa os PDFs oficiais e pode levar alguns minutos
TimeoutStartSec=30min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/project-accounting
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
