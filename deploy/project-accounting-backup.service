# Cópia diária do banco — copie para /etc/systemd/system/
# Disparado pelo project-accounting-backup.timer; guarda as últimas BACKUP_KEEP cópias.

[Unit]
Description=Project Accounting — cópia diária do banco

[Service]
Type=oneshot
User=project-accounting
Group=project-accounting
WorkingDirectory=/opt/project-accounting/backend
EnvironmentFile=/opt/project-accounting/.env
ExecStart=/opt/project-accounting/backend/.venv/bin/flask db-backup

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/project-accounting
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
