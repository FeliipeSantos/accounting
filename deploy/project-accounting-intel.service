# Coleta diária da Inteligência Contábil — copie para /etc/systemd/system/
# Disparado pelo project-accounting-intel.timer a cada 5 minutos: o comando só coleta
# quando está na hora configurada (recupera coleta perdida e repete falhas até 3 vezes no dia).

[Unit]
Description=Project Accounting — coleta diária da Inteligência Contábil
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=project-accounting
Group=project-accounting
WorkingDirectory=/opt/project-accounting/backend
EnvironmentFile=/opt/project-accounting/.env
ExecStart=/opt/project-accounting/backend/.venv/bin/flask intel scheduled
# a coleta da Câmara pode levar alguns minutos
TimeoutStartSec=15min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/project-accounting
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
