# systemd unit — copie para /etc/systemd/system/project-accounting.service
# Ajuste os caminhos se instalar o código em outra pasta (veja DEPLOY.md).

[Unit]
Description=Project Accounting (Portal de Projetos + Inteligência Contábil)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=project-accounting
Group=project-accounting
WorkingDirectory=/opt/project-accounting
# O .env fica na pasta do código; o próprio "npm start" também o carrega
EnvironmentFile=/opt/project-accounting/.env
ExecStart=/usr/bin/node --env-file-if-exists=.env server.js
Restart=always
RestartSec=5
# Dá tempo para uma coleta em andamento terminar ao parar/reiniciar
TimeoutStopSec=30
KillSignal=SIGTERM

# --- Endurecimento -------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Único lugar onde o processo pode gravar: os dados
ReadWritePaths=/var/lib/project-accounting
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
