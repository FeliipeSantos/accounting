# systemd unit do backend Flask — copie para /etc/systemd/system/opencontabil-api.service
# Veja DEPLOY.md. Em VPS vinda da versão antiga, não roda junto com o
# project-accounting.service (Node): os dois usariam a porta 8080.

[Unit]
Description=opencontabil API (Flask + gunicorn)
After=network-online.target
Wants=network-online.target
Conflicts=project-accounting.service

[Service]
Type=simple
User=opencontabil
Group=opencontabil
WorkingDirectory=/opt/opencontabil/backend
EnvironmentFile=/opt/opencontabil/.env
ExecStart=/opt/opencontabil/backend/.venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=always
RestartSec=5
# Dá tempo para uma coleta manual em andamento terminar ao parar/reiniciar
TimeoutStopSec=30
KillSignal=SIGTERM

# --- Endurecimento -------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Único lugar onde o processo pode gravar: os dados
ReadWritePaths=/var/lib/opencontabil
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
