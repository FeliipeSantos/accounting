# Copie para .env e ajuste. O .env NUNCA vai para o git (já está no .gitignore).
# Carregado automaticamente por "npm start", "npm run dev" e pelos comandos intel:*.

# --- Ambiente -------------------------------------------------------------
# "production" exige usuários configurados e marca o cookie de sessão como Secure (só HTTPS)
NODE_ENV=production

# --- Rede -----------------------------------------------------------------
# Atrás do Nginx, escute apenas localmente: o acesso externo passa pelo HTTPS do Nginx
HOST=127.0.0.1
PORT=8080
# true quando há um proxy reverso (Nginx) na frente: usa o IP real do X-Forwarded-For
# no limite de tentativas de login. Deixe false se o Node estiver exposto direto.
TRUST_PROXY=true

# --- Fuso horário ---------------------------------------------------------
# A coleta diária roda na hora local do processo. VPS costuma vir em UTC.
TZ=America/Sao_Paulo

# --- Usuários ---------------------------------------------------------------
# Gere cada linha com: npm run auth:hash -- <usuario>
# Vários usuários separados por vírgula: usuario1:hash1,usuario2:hash2
AUTH_USERS=
# Duração da sessão sem uso, em horas
SESSION_TTL_HOURS=8
# Em produção o cookie já é Secure. Só use false para testar produção sem HTTPS.
# COOKIE_SECURE=false

# --- Dados ----------------------------------------------------------------
# Fora da pasta do código facilita atualizações e backup
DB_FILE=/var/lib/project-accounting/db.json
INTEL_DB_FILE=/var/lib/project-accounting/intelligence-db.json

# --- Inteligência Contábil ------------------------------------------------
# "off" desliga a coleta diária automática (a manual continua disponível)
# INTEL_SCHEDULER=off
