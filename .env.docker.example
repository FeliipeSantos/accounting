# Configuração do opencontabil em Docker. Copie para .env.docker e ajuste:
#   cp .env.docker.example .env.docker
# O .env.docker NUNCA vai para o git nem para a imagem. Veja DOCKER.md.
#
# Já vêm prontos na imagem: APP_ENV=production, HOST=0.0.0.0, PORT=8080,
# TZ=America/Sao_Paulo e DB_PATH=/data/app.db (banco no volume "data").

# --- Rede -----------------------------------------------------------------
# O Nginx do container "web" fica na frente da api e repassa o IP real do visitante
TRUST_PROXY=true

# --- Sessão -----------------------------------------------------------------
SESSION_TTL_HOURS=8
# Em produção o cookie da sessão só vale em HTTPS. Para testar SEM HTTPS (por exemplo,
# http://IP-do-servidor:8080), descomente a linha abaixo; com HTTPS na frente, deixe comentada.
# COOKIE_SECURE=false

# --- Banco de dados ---------------------------------------------------------
# Cópias diárias (às 03:00, pelo container "scheduler"): quantas manter em /data/backups
BACKUP_KEEP=7

# --- Publicações ------------------------------------------------------------
# "off" desliga a coleta diária automática (a manual continua disponível)
# INTEL_SCHEDULER=off

# --- Calendário -------------------------------------------------------------
# Módulo de uso pessoal: e-mails de login com acesso (separados por vírgula)
# REFORMA_USERS=seu@email.com.br
# REFORMA_RUN_TIME=07:00
# REFORMA_SCHEDULER=off
